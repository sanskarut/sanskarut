# =============================================
#   Sansrut Mail Engine — Backend Environment
# =============================================
# Copy this file to .env and fill in your values

# MongoDB Connection (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sansrut_mail_db

# Server Port
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret — change this to a long random string in production!
JWT_SECRET=sansrut-core-security-secret-key-321

# ─── SMTP Configuration ───────────────────────────────────────────
# Leave blank to use the built-in mock/console transporter
# Use Gmail, Mailtrap, Resend, or your own SMTP server

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Sansrut Mail Engine" <noreply@sanskarut.com>

# ─── Mailtrap (for development testing) ──────────────────────────
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-user
# SMTP_PASS=your-mailtrap-pass
